# Copy this file to .env and fill in the values for whichever provider you use.
# .env is loaded automatically and is gitignored — never commit real keys.

# Required: anthropic | openai-compatible
NEWSLETTER_DISTILLER_PROVIDER=anthropic

# Required: the model name to use with the selected provider
NEWSLETTER_DISTILLER_MODEL=claude-sonnet-5

# --- Anthropic (used when NEWSLETTER_DISTILLER_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- OpenAI-compatible (used when NEWSLETTER_DISTILLER_PROVIDER=openai-compatible) ---
# Covers Ollama, DeepSeek, Kimi/Moonshot, or any other OpenAI-compatible endpoint.
NEWSLETTER_DISTILLER_API_KEY=
NEWSLETTER_DISTILLER_BASE_URL=

# Optional: override automatic vision-capability detection (true|false)
NEWSLETTER_DISTILLER_VISION=
