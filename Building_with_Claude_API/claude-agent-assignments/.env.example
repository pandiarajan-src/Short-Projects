# Assignments 1-3 call the Claude API directly and need an API key.
# Create one at https://platform.claude.com -> API Keys (API usage is billed
# separately from a Claude Pro subscription).
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Optional: model to use. Defaults to claude-opus-5-5.
# claude-haiku-5-5 is much cheaper and fine for practice.
# CLAUDE_MODEL=claude-haiku-5-5

# Assignment 4 (Agent SDK) uses your Claude Pro login by default.
# Set to "api_key" to make it use ANTHROPIC_API_KEY instead.
# AGENT_AUTH=subscription
